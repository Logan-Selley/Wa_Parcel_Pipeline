# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# docker-compose.yml reads this file implicitly for ${VAR} substitution.
# dbt reads it via profiles.yml env_var() calls, so it must be exported into
# the shell before running dbt:
#
#   set -a; . ./.env; set +a          # bash/zsh
#   export (cat .env | grep -v '^#')  # fish

POSTGRES_USER=parcel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=parcels

# The warehouse container maps 5433 on the host to 5432 in the container,
# so anything running outside Docker connects on 5433.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433
