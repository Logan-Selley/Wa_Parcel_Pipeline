# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# docker-compose.yml reads this file implicitly for ${VAR} substitution.
#
# dbt does NOT read this file. env_var() in profiles.yml reads the process
# environment, so it has to be exported before dbt starts -- there is no
# --env-file flag in dbt-core.
#
# Use the Makefile, which handles this (and pins .venv/bin/dbt, because a bare
# `dbt` on PATH may resolve to dbt Fusion, which has no Postgres adapter):
#
#   make build          # routine build
#   make check          # verify env before blaming a query
#
# To source it by hand:
#
#   set -a; . ./.env; set +a          # bash/zsh
#
# The obvious fish one-liner `export (cat .env | grep -v '^#')` does NOT work:
# blank lines produce an empty element and fish's export rejects it. In fish:
#
#   for l in (grep -vE '^#|^$' .env); set -gx (string split -m1 = $l); end

POSTGRES_USER=parcel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=parcels

# The warehouse container maps 5433 on the host to 5432 in the container,
# so anything running outside Docker connects on 5433.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433
