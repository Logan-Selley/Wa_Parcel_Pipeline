# --- secrets -----------------------------------------------------------------
# .env holds the real warehouse password. .env.example is the tracked template.
.env
.env.*
!.env.example

# --- python ------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- dbt ---------------------------------------------------------------------
# these appear under parcels/, but match at any depth in case dbt is invoked
# from a different working directory
target/
dbt_packages/
logs/
.user.yml

# --- source data -------------------------------------------------------------
# county downloads (shapefiles, FGDBs, geojson) are large and re-fetchable.
# The pipeline must be able to reconstruct these from config, never from git.
data/

# --- os ----------------------------------------------------------------------
.DS_Store

# --- editors ----------------------------------------------------------------
.idea/
.vscode/
*.swp

# --- generated exports --------------------------------------------------------
# `make export` writes 3.2 GB here (2.2G csv, 590M fgb, 414M parquet) and every
# byte is reproducible from the warehouse. The small JSON the static site reads
# is the exception: it is what makes site/ servable without a build step.
#
# NOTE the trailing /* -- `exports/` alone would stop git descending into the
# directory at all, so the negation below could never re-include anything.
exports/*
!exports/json/
site/data/
