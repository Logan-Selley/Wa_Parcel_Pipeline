# --- secrets -----------------------------------------------------------------
# .env holds the real warehouse password. .env.example is the tracked template.
.env
.env.*
!.env.example

# --- python ------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- dbt ---------------------------------------------------------------------
# these appear under parcels/, but match at any depth in case dbt is invoked
# from a different working directory
target/
dbt_packages/
logs/
.user.yml

# --- source data -------------------------------------------------------------
# county downloads (shapefiles, FGDBs, geojson) are large and re-fetchable.
# The pipeline must be able to reconstruct these from config, never from git.
# Anchored: unanchored, this pattern also matches site/data, which IS tracked.
/data/

# --- os ----------------------------------------------------------------------
.DS_Store

# --- editors ----------------------------------------------------------------
.idea/
.vscode/
*.swp

# --- generated exports --------------------------------------------------------
# `make export` writes 3.2 GB here (2.2G csv, 590M fgb, 414M parquet) and every
# byte is reproducible from the warehouse. The small JSON the static site reads
# is the exception: it is what makes site/ servable without a build step.
#
# NOTE the trailing /* -- `exports/` alone would stop git descending into the
# directory at all. Nothing under exports/ is committed; the site's copies of
# the JSON live under site/data/.
exports/*

# site/data IS tracked -- it is what makes site/ a self-contained publishable
# directory. index.html fetches data/*.json and data/pmtiles/*.pmtiles by
# relative path, so ignoring this directory meant GitHub Pages would serve the
# page and 404 every request it made.
#
# Only viable because the map was cut to findings: the old full-parcel archive
# would have been 150-400 MB against GitHub's hard 100 MB file limit. The
# findings archive is ~18 MB.
#
# The cost is real and worth knowing: the .pmtiles is a binary that changes
# wholesale on every rebuild, so each committed refresh adds its full size to
# git history permanently. Commit it when publishing, not on every run --
# which is also why the DAG generates artifacts but never commits them.
